# Porta da API
API_PORT=3001

# Conexão com o MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ellp_ctrl

# Assinatura dos tokens de acesso (troque em produção)
JWT_SECRET=troque-esta-chave-em-producao
JWT_EXPIRES=8h

# Administrador criado na carga inicial (seed)
ADMIN_NAME=Administrador do ELLP
ADMIN_USER=admin
ADMIN_PASSWORD=ellp-admin

# Senha inicial dos voluntários criados na carga inicial
VOLUNTARIO_SENHA_PADRAO=ellp-2026

# Origem liberada para o frontend (CORS)
CORS_ORIGIN=http://localhost:5173
